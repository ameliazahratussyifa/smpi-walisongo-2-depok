# ==============================================================================
# SMP ISLAM WALISONGO 2 DEPOK - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env atau .env.local dan isi dengan konfigurasi rahasia Anda.
# CATATAN: File .env dan .env.local TIDAK AKAN PERNAH terunggah ke repository GitHub.
# ==============================================================================

# Port Backend & Frontend
PORT=8000
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:8000

# Secret Key untuk Cookie Sesi & Otentikasi Admin
SESSION_SECRET=ganti-dengan-string-acak-yang-sangat-rahasia-dan-kuat-2026

# Konfigurasi Supabase Cloud (Opsional - Jika kosong, otomatis fallback ke SQLite lokal aman)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
